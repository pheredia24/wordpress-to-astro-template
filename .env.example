# Sanity (required for Studio and seed script)
# Create a project at https://sanity.io/manage and use its project ID.
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production

# Optional: needed for seed script to create/update documents and upload assets
# Create token at https://sanity.io/manage → API → Tokens
# SANITY_API_TOKEN=your_token

# Optional: URL for contact form (Formspree, Resend, etc.). If set, the contact form action uses it.
# PUBLIC_CONTACT_FORM_ACTION=https://formspree.io/f/xxxxx

# Optional: Vercel Deploy Hook URL for Sanity Studio (trigger rebuild when content is published).
# Create in Vercel: Project → Settings → Git → Deploy Hooks → Add hook, copy URL.
# SANITY_STUDIO_VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
